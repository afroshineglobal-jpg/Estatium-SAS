# ─── Copy to server/.env and fill in. NEVER commit server/.env. ───────────────────────────
NODE_ENV=development
PORT=3001

# PostgreSQL. Run the app as the NOBYPASSRLS role (estatium_app); run migrations as the owner role.
DATABASE_URL=postgresql://estatium_app:CHANGE_ME@localhost:5432/estatium
# Prisma migrations use this (owner role):
# DIRECT_URL=postgresql://estatium_owner:CHANGE_ME@localhost:5432/estatium

# Two DIFFERENT random secrets, >= 32 chars:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PLATFORM_JWT_SECRET=
JWT_EXPIRES_IN=8h
PLATFORM_JWT_EXPIRES_IN=4h

# Browser origins allowed to call the API (comma separated). Sub-domains of TENANT_BASE_DOMAIN are allowed automatically.
CORS_ORIGINS=http://localhost:3000
# e.g. estatium.app  ->  greenville.estatium.app resolves to tenant "greenville"
TENANT_BASE_DOMAIN=

# Behind nginx / a load balancer set 1 so rate limits and audit logs see the real client IP
TRUST_PROXY=0
# Defence in depth: PostgreSQL row-level security per request (needs sql/002 applied + estatium_app role)
ENABLE_RLS=false
# Optional: comma separated IPs allowed to reach /api/platform
PLATFORM_ALLOWED_IPS=
# Run billing/overdue jobs in this process (set false on web-only replicas)
RUN_JOBS=true

# Firebase push (optional) — use a NEW service-account key; the old one was published in git history
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
