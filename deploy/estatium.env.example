# Production environment for the Estatium API.
# Install as /etc/estatium/estatium.env  (owner root, group estatium, mode 640). NEVER commit the real file.
NODE_ENV=production
PORT=3001

# The RESTRICTED role (estatium_app, NOBYPASSRLS). Never use the owner role here.
DATABASE_URL=postgresql://estatium_app:PASTE_APP_PASSWORD@127.0.0.1:5432/estatium

# Two DIFFERENT random secrets, 48+ bytes:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PLATFORM_JWT_SECRET=
JWT_EXPIRES_IN=8h
PLATFORM_JWT_EXPIRES_IN=4h

CORS_ORIGINS=https://estatium.afroshineglobal.com
TENANT_BASE_DOMAIN=
TRUST_PROXY=1
ENABLE_RLS=true
RUN_JOBS=true
UPLOAD_DIR=/var/lib/estatium/uploads
PLATFORM_ALLOWED_IPS=

# Firebase push (optional until push tokens are wired up). Use a NEW service-account key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
